# --- Telegram ---
# Токен от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Hirify ---
# Cookie из браузера после входа на hirify.me (см. README, раздел «Авторизация»).
# Можно не задавать здесь, а прислать боту командой /setcookie в личке — либо
# создать аккаунт автоматом: Actions → auth (режим GitHub Actions).
HIRIFY_COOKIE=
# База JSON-API сайта (менять не нужно; Laravel Sanctum, отдельный домен)
HIRIFY_API_BASE=https://api.hirify.me

# Какие разделы hirify.me мониторить (через запятую):
#   remote        — Удалёнка (полностью удалённые IT-вакансии)
#   global        — Глобальная удалёнка (work from anywhere)
#   crypto        — Crypto & Web3 (крипто-индустрия)
#   crypto_remote — крипта + удалёнка
#   all           — общий фид без раздела
# или свой лендинг: /fintech-jobs
HIRIFY_FEEDS=remote,global,crypto

# Строгая проверка разделов (страховка поверх серверных лендингов):
# REMOTE_STRICT=1 — выкидывать вакансию, если на её странице явно указан офис/гибрид;
# CRYPTO_STRICT=1 — в разделе crypto оставлять только вакансии с крипто-признаками
# (заголовок/навыки/компания/описание);
# INDUSTRY_STRICT=1 — рассылать ТОЛЬКО вакансии целевых индустрий: iGaming/гемблинг/
# беттинг, дейтинг, high-risk- и NDA-проекты, крипта и смежные (признаки —
# INDUSTRY_RE в app/parsing.py). Вакансии «обычных» компаний отсеиваются.
REMOTE_STRICT=1
CRYPTO_STRICT=1
INDUSTRY_STRICT=1

# Фильтр вакансий (параметры URL фида hirify.me, через &).
# По умолчанию: только вакансии с прямым Telegram-контактом, самые свежие.
# Примеры параметров: countries=ru | salary_from=2000 | specializations=backend |
# grade=senior | vacancy_language=ru | search=python
HIRIFY_FEED_PARAMS=only_direct_contact=1&contact_types=telegram&sort_by=newest

# Пауза между запросами страниц (вежливость к сайту), сек
FETCH_DELAY_SEC=1.5
REQUEST_TIMEOUT_SEC=30

# --- Мониторинг ---
# Базовый интервал проверки фида, минут. Карточка должна приходить почти сразу,
# поэтому по умолчанию всего 5 минут.
POLL_MINUTES=5
# Быстрая повторная проверка после прохода, где было новое (сек):
# «пачка» вакансий уходит подряд, не дожидаясь следующего цикла.
FAST_POLL_SEC=120
# Сколько новых вакансий открывать за один цикл
MAX_PER_POLL=8
# Сколько страниц фида просматривать за цикл
FEED_PAGES=1

# --- Отправка ---
# 1 = Rich Messages (Bot API 10.1+, красивые HTML-блоки) с автооткатом на обычный HTML;
# 0 = всегда обычный HTML
USE_RICH=1
# 1 = разрешить HTML-виджеты (Bot API 10.4, Telegram 13.2+) для тех, кто выбрал
# «Пузырь» в /settings; при сбое — автооткат на rich/классику. 0 = виджеты выключены.
USE_WIDGET=1
# Максимум символов описания в карточке
DESCRIPTION_LIMIT=1800
SEND_DELAY_SEC=1.2

# --- Служебное ---
DB_PATH=data/hirify_bot.db
LOG_LEVEL=INFO

# --- Хостинг с автоперезапуском (GitHub Actions) ---
# Лимит времени работы, минут: после него бот плавно останавливается, чтобы
# воркфлоу сохранил БД и перезапустил сам себя (job Actions живёт максимум 6 ч).
# 0 или пусто = без лимита (обычный запуск на сервере/VPS)
RUN_MAX_MINUTES=
# Сбрасывать накопившиеся апдейты Telegram при старте (1 = да, по умолчанию).
# В режиме Actions выключаем (0): команды из минутного зазора между ранами
# не должны теряться.
DROP_PENDING_UPDATES=1
